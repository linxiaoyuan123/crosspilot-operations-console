---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import ImmersiveHero from '../components/ImmersiveHero.astro';

type Props = {
  title?: string;
  description?: string;
  eyebrow?: string;
  pageTitle?: string;
  hero?: boolean;
  compactHero?: boolean;
  workspaceAside?: boolean;
};

const {
  title = 'CrossPilot · 跨境电商运营决策中台',
  description = 'CrossPilot 把报表导入、利润诊断、动作执行和内容复盘放在同一套工作流里。',
  eyebrow = 'CrossPilot 内容与运营总览',
  pageTitle = '运营工作区',
  hero = false,
  compactHero = true,
  workspaceAside = false
} = Astro.props;
---

<!doctype html>
<html
  lang="zh-CN"
  data-font-mode="literary"
  data-theme-mode="dark"
  data-theme="dark"
  data-wallpaper-mode="fullscreen"
  data-fullscreen-layout="classic"
>
  <head>
    <meta charset="UTF-8" />
    <ClientRouter />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#123b3a" />
    <link rel="icon" type="image/png" href="/pig.png" />
    <title>{title}</title>
    <style is:inline>
      html, body { background: #07111f; }
      html[data-theme="light"], html[data-theme="light"] body { background: #eaf2f7; }
    </style>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('crosspilot-color-mode') || 'dark';
          const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const resolved = stored === 'system' ? (systemDark ? 'dark' : 'light') : stored === 'light' ? 'light' : 'dark';
          document.documentElement.dataset.themeMode = stored;
          document.documentElement.dataset.theme = resolved;
          document.documentElement.classList.toggle('dark', resolved === 'dark');
          document.documentElement.dataset.fontMode = localStorage.getItem('crosspilot-font-mode') || 'literary';
        } catch {}
      })();
    </script>
    <link rel="stylesheet" href="/styles.css" />
    <link rel="stylesheet" href="/final-shell.css" />
    <link rel="stylesheet" href="/crosspilot.css" />
    <link rel="stylesheet" href="/enhancements.css" />
    <link rel="stylesheet" href="/theme-controls.css" />
    <link rel="stylesheet" href="/nav-shell.css" />
    <link rel="stylesheet" href="/page-transition.css" />
  </head>
  <body class="content-page">
    <div id="sakura-layer" aria-hidden="true"></div>
    <div class="app-shell">
      <SiteHeader />
      <div class="workspace">
        {hero && <ImmersiveHero compact={compactHero} />}
        <div class:list={['page-frame', { single: !workspaceAside }]}>
          <div class="page-main">
            <main class="content">
              <slot />
            </main>
          </div>
        </div>
        <footer class="site-footer">
          <span>CrossPilot · 本地优先的跨境运营工作区</span>
          <span>Astro + Svelte + Node + SQLite</span>
        </footer>
      </div>
    </div>

    <div id="modal-root"></div>
    <div class="toast-stack" id="toast-root" aria-live="polite"></div>

    <script is:inline>
      (() => {
        const runtimeKey = '__crosspilotPageRuntime';
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const update = () => {
          const root = document.scrollingElement || document.documentElement;
          const maxScroll = Math.max(0, root.scrollHeight - window.innerHeight);
          const scrollProgress = document.querySelector('#app-scroll-progress');
          if (scrollProgress) {
            scrollProgress.style.transform = `scaleX(${maxScroll ? Math.min(1, window.scrollY / maxScroll) : 0})`;
          }
          document.querySelector('.app-header')?.classList.toggle('is-scrolled', window.scrollY > 8);
        };

        if (!window[runtimeKey]) {
          let transitionAnimation = null;

          const startTransition = () => {
            document.documentElement.classList.add('is-page-transitioning');
            const bar = document.querySelector('#page-transition-progress i');
            if (!bar) return;
            transitionAnimation?.cancel();
            transitionAnimation = bar.animate(
              [
                { transform: 'scaleX(0.04)', opacity: 1 },
                { transform: 'scaleX(0.72)', opacity: 1 },
                { transform: 'scaleX(0.9)', opacity: 1 }
              ],
              {
                duration: reduceMotion ? 1 : 5000,
                easing: 'cubic-bezier(0.12, 0.72, 0.18, 1)',
                fill: 'forwards'
              }
            );
          };

          const finishTransition = () => {
            const bar = document.querySelector('#page-transition-progress i');
            transitionAnimation?.cancel();
            transitionAnimation = null;
            if (bar) {
              const animation = bar.animate(
                [
                  { transform: 'scaleX(0.96)', opacity: 1 },
                  { transform: 'scaleX(1)', opacity: 1 },
                  { transform: 'scaleX(1)', opacity: 0 }
                ],
                { duration: reduceMotion ? 1 : 420, easing: 'ease-out', fill: 'forwards' }
              );
              animation.finished.finally(() => {
                bar.style.transform = 'scaleX(0)';
                bar.style.opacity = '0';
              });
            }
            window.requestAnimationFrame(() => document.documentElement.classList.remove('is-page-transitioning'));
          };

          const refresh = () => {
            update();
          };

          window[runtimeKey] = { refresh, startTransition, finishTransition };
          window.addEventListener('scroll', update, { passive: true });
          window.addEventListener('resize', update);
          window.addEventListener('pageshow', finishTransition);
          document.addEventListener('astro:before-preparation', startTransition, true);
          document.addEventListener('astro:after-swap', refresh);
          document.addEventListener('astro:page-load', finishTransition);
          document.addEventListener('click', (event) => {
            if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
            const link = event.target instanceof Element ? event.target.closest('a[href]') : null;
            if (!link || !link.hasAttribute('data-astro-reload') || link.target === '_blank' || link.hasAttribute('download')) return;
            const target = new URL(link.href, location.href);
            if (target.origin !== location.origin || target.href === location.href) return;
            event.preventDefault();
            startTransition();
            window.setTimeout(() => location.assign(target.href), reduceMotion ? 0 : 90);
          }, true);
        }

        const layer = document.querySelector('#sakura-layer');
        if (layer && !layer.childElementCount) {
          layer.innerHTML = Array.from({ length: 28 }, (_, index) => {
            const left = (index * 37 + 9) % 100;
            const size = 7 + ((index * 5) % 7);
            const drift = 24 + ((index * 29) % 72);
            const duration = 13 + ((index * 7) % 12);
            const delay = -((index * 11) % 19);
            return `<span class="sakura-petal" style="--left:${left}%;--size:${size}px;--drift:${drift}px;--duration:${duration}s;--delay:${delay}s"></span>`;
          }).join('');
        }

        update();
      })();
    </script>
    <script is:inline src="/enhancements.js"></script>
  </body>
</html>

<style>
  :global(body.content-page) {
    background:
      linear-gradient(180deg, rgba(5, 15, 27, 0.72), rgba(4, 12, 23, 0.86)),
      url('/assets/hero-crosspilot-2.avif') center / cover fixed no-repeat,
      #07111f;
    min-height: 100vh;
  }

  :global(html[data-theme="light"] body.content-page) {
    background:
      linear-gradient(180deg, rgba(239, 246, 250, 0.78), rgba(228, 239, 245, 0.9)),
      url('/assets/hero-crosspilot-2.avif') center / cover fixed no-repeat,
      #edf3f7;
  }

  :global(body.content-page .workspace) {
    padding: 112px clamp(18px, 4vw, 56px) 58px;
  }

  :global(body.content-page .page-frame),
  :global(body.content-page .page-frame.single) {
    grid-template-columns: minmax(0, 1fr);
    margin: 0 auto;
    max-width: 1280px;
    padding: 0;
    width: 100%;
  }

  :global(body.content-page .page-main) {
    animation: cp-content-enter 280ms cubic-bezier(0.16, 1, 0.3, 1) both;
    min-width: 0;
  }

  :global(body.content-page .content) {
    min-width: 0;
    padding-bottom: 36px;
  }

  :global(body.content-page .content .panel),
  :global(body.content-page .content .cp-card) {
    -webkit-backdrop-filter: blur(24px) saturate(150%);
    backdrop-filter: blur(24px) saturate(150%);
    background:
      linear-gradient(145deg, rgba(23, 47, 70, 0.77), rgba(8, 24, 40, 0.73)),
      linear-gradient(115deg, rgba(255, 255, 255, 0.07), transparent 36%);
    border-color: rgba(185, 225, 244, 0.18);
  }

  :global(body.content-page .content .panel) {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.09),
      inset 0 -1px 0 rgba(255, 255, 255, 0.025),
      0 18px 48px rgba(0, 0, 0, 0.22);
  }

  :global(html[data-theme="light"] body.content-page .content .panel),
  :global(html[data-theme="light"] body.content-page .content .cp-card) {
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.84), rgba(239, 247, 251, 0.76)),
      linear-gradient(115deg, rgba(255, 255, 255, 0.62), transparent 42%);
    border-color: rgba(50, 91, 114, 0.15);
  }

  :global(html[data-theme="light"] body.content-page .content .panel) {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.96),
      0 18px 42px rgba(42, 78, 99, 0.11);
  }

  @keyframes cp-content-enter {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  :global(.page-frame.single .page-main) {
    grid-column: 1;
  }

  :global(.wallpaper-wrapper.is-compact .hero-banner) {
    height: min(68vh, 680px);
    min-height: 500px;
  }

  :global(html[data-wallpaper-mode="banner"] .wallpaper-wrapper.is-compact .hero-banner) {
    height: min(58vh, 590px);
    min-height: 430px;
  }

  :global(.content) {
    min-width: 0;
  }

  .site-footer {
    align-items: center;
    color: #71899d;
    display: flex;
    font-size: 12px;
    justify-content: space-between;
    margin: 0 auto;
    max-width: 1280px;
    padding: 22px 0 8px;
  }

  :global(html[data-theme="light"] .site-footer) {
    color: #60798a;
  }

  @media (max-width: 760px) {
    :global(body.content-page .workspace) {
      padding: 202px 12px 42px;
    }

    .site-footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
